# === Drift Orderbook Watcher — configuration ===
# Copy to .env: cp config.example.env .env

# --- Solana RPC (REQUIRED) ---
# Recommended: free Helius RPC with a verified email (https://dev.helius.xyz)
# The public mainnet URL also works (cached subscription), but it is slower/limited.
RPC_URL=https://api.mainnet-beta.solana.com

# Drift environment: mainnet or devnet
DRIFT_ENV=mainnet

# Optional: path to your own read wallet keypair.
# LEAVE EMPTY to watch read-only with an ephemeral wallet (recommended).
KEYPAIR_PATH=

# --- Watched markets (comma-separated) ---
MARKETS=SOL-PERP

# Orderbook depth (price levels per side)
ORDERBOOK_DEPTH=20

# DLOB rebuild frequency (ms)
UPDATE_FREQUENCY_MS=1000

# Max seconds to wait for a single get_l2() call before treating it as a
# failed poll (protects against a stuck/slow RPC freezing the whole watcher).
SNAPSHOT_TIMEOUT_SEC=5

# --- Detector thresholds ---
REPEATED_MIN_COUNT=4
REPEATED_SIZE_TOLERANCE=0.001
LAYERING_MIN_LEVELS=5
FLICKER_WINDOW_SEC=5
FLICKER_MIN_EVENTS=3
# Orderbook imbalance: |bid-ask|/(bid+ask) over the top N levels (0..1)
IMBALANCE_MIN_RATIO=0.85
IMBALANCE_MIN_LEVELS=5
# Ignore imbalance on a near-empty book (total top-N size below this) so a
# single tiny resting order on one side doesn't read as "one-sided pressure".
# 0 = disabled (no liquidity floor).
IMBALANCE_MIN_TOTAL_VOLUME=0
# Spoof-pull: a large wall (>= RATIO x median level size) cancelled while the
# mid price moves at least MIN_PRICE_MOVE (relative) within WINDOW_SEC.
SPOOF_WINDOW_SEC=10
SPOOF_WALL_RATIO=5
SPOOF_MIN_PRICE_MOVE=0.001
SPOOF_PULL_FRACTION=0.5       # flag when remaining size < this fraction of the wall

# --- Risk aggregation ---
# Combine detector scores into one smoothed risk level per market.
# Set RISK_AGGREGATION=false to emit one alert per raw detection instead.
RISK_AGGREGATION=true
RISK_SMOOTHING=0.4            # EMA factor (0..1); higher = more reactive
RISK_ALERT_THRESHOLD=0.6      # raise an alert above this level
RISK_CLEAR_THRESHOLD=0.4      # clear the elevated state below this (hysteresis)
RISK_ALERT_COOLDOWN_SEC=30    # min seconds between repeated risk alerts

# --- Health-check ---
# Periodically re-runs the algorithmic self-test in-process and alerts if any
# detector stops firing on its known-positive scenario. Off by default.
HEALTHCHECK_ENABLED=false
HEALTHCHECK_INTERVAL_SEC=300

# --- Feed liveness / reconnect ---
# After this many consecutive failed snapshot polls, tear down and rebuild
# the live Drift connection instead of polling a dead one forever.
FEED_MAX_CONSECUTIVE_FAILURES=5
# With HEALTHCHECK_ENABLED=true, also alert if no snapshot has succeeded in
# this many seconds — catches a feed that's silently stuck, not just one
# that raises.
FEED_STALE_AFTER_SEC=120

# --- Storage (time-series persistence; foundation for replay/dashboard) ---
# Persist detections + risk scores to SQLite. Off by default.
STORAGE_ENABLED=false
DB_PATH=data/watcher.db
# Also persist full L2 books (high volume) — leave false unless you need replay.
PERSIST_SNAPSHOTS=false

# --- Dashboard (python main.py --dashboard; reads the DB above) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# --- Alerting ---
ALERT_MIN_SCORE=0.6
ALERT_FORMAT=console          # console or json

# Optional webhook alerts (leave empty to disable).
# Discord (or any generic webhook accepting {"content": "..."}):
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_URL must be http(s) and, by default, not a private/loopback/
# link-local address (blocks accidental SSRF against internal services, e.g.
# a cloud metadata endpoint). Set this to true only if that's intentional
# (e.g. a webhook receiver running on your own LAN).
ALERT_WEBHOOK_ALLOW_PRIVATE_HOST=false
# Telegram (both required): token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Run duration (0 = forever, until Ctrl+C) ---
RUN_DURATION_SEC=0
