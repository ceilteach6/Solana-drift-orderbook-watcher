# === Drift Orderbook Watcher — configuration ===
# Copy to .env: cp config.example.env .env

# --- Solana RPC (REQUIRED) ---
# Recommended: free Helius RPC with a verified email (https://dev.helius.xyz)
# The public mainnet URL also works (cached subscription), but it is slower/limited.
RPC_URL=https://api.mainnet-beta.solana.com

# Drift environment: mainnet or devnet
DRIFT_ENV=mainnet

# Optional: path to your own read wallet keypair.
# LEAVE EMPTY to watch read-only with an ephemeral wallet (recommended).
KEYPAIR_PATH=

# --- Watched markets (comma-separated) ---
MARKETS=SOL-PERP

# Orderbook depth (price levels per side)
ORDERBOOK_DEPTH=20

# DLOB rebuild frequency (ms)
UPDATE_FREQUENCY_MS=1000

# --- Detector thresholds ---
REPEATED_MIN_COUNT=4
REPEATED_SIZE_TOLERANCE=0.001
LAYERING_MIN_LEVELS=5
FLICKER_WINDOW_SEC=5
FLICKER_MIN_EVENTS=3

# --- Alerting ---
ALERT_MIN_SCORE=0.6
ALERT_FORMAT=console          # console or json

# --- Run duration (0 = forever, until Ctrl+C) ---
RUN_DURATION_SEC=0
