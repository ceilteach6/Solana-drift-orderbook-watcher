# === Drift Orderbook Watcher — configuration ===
# Copy to .env: cp config.example.env .env

# --- Solana RPC (REQUIRED) ---
# Recommended: free Helius RPC with a verified email (https://dev.helius.xyz)
# The public mainnet URL works for demos but is rate-limited for sustained use.
RPC_URL=https://api.mainnet-beta.solana.com

# Drift environment: mainnet or devnet
DRIFT_ENV=mainnet

# Optional: path to your own read wallet keypair JSON file.
# Leave EMPTY to watch with an ephemeral wallet (recommended — safer).
KEYPAIR_PATH=

# --- Watched markets (comma-separated) ---
MARKETS=SOL-PERP

# Orderbook depth (price levels per side fetched from the DLOB)
ORDERBOOK_DEPTH=20

# DLOB rebuild / poll frequency (milliseconds, minimum 50)
UPDATE_FREQUENCY_MS=1000

# --- Detector thresholds ---
REPEATED_MIN_COUNT=4
REPEATED_SIZE_TOLERANCE=0.001
LAYERING_MIN_LEVELS=5
FLICKER_WINDOW_SEC=5
FLICKER_MIN_EVENTS=3
# Orderbook imbalance: |bid_vol - ask_vol| / (bid_vol + ask_vol) in top N levels
IMBALANCE_MIN_RATIO=0.85
IMBALANCE_MIN_LEVELS=5

# --- Alerting ---
# Minimum detection score to trigger an alert (0.0 - 1.0)
ALERT_MIN_SCORE=0.6
# Output format: console (human-readable) or json (one JSON object per line)
ALERT_FORMAT=console

# Webhook alerts - leave empty to disable.
# Discord (or any generic webhook accepting {"content": "..."}):
ALERT_WEBHOOK_URL=
# Telegram (both fields required): get token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Run duration ---
# 0 = run forever (until Ctrl+C); set e.g. 300 to stop after 5 minutes
RUN_DURATION_SEC=0
