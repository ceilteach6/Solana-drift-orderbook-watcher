# Secrets
# NOTE: intentionally narrower than "*.env" — that pattern also swallows
# tracked templates like config.example.env (and any future *.env.example),
# silently `git add`-blocking them without -f. `.env*` still catches real
# local secret files (.env, .env.local, .env.production, ...).
.env
.env.*
*keypair*.json
*secret*
*.pem

# ...but never ignore checked-in example/template env files.
!*.example.env
!*.env.example

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs / data
*.log
data/
